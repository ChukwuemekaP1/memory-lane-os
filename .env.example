# Memory Lane — environment template. Copy to .env and adjust.
# NEVER commit real secrets. Every variable below is read by the backend
# Settings (backend/app/config.py) or docker-compose.yml.

# --- App ---
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true
APP_VERSION=0.1.0

# --- Database (compose defaults match these) ---
POSTGRES_USER=memorylane
POSTGRES_PASSWORD=memorylane
POSTGRES_DB=memorylane_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://memorylane:memorylane@127.0.0.1:5432/memorylane_dev
TEST_DATABASE_URL=postgresql+asyncpg://memorylane:memorylane@127.0.0.1:5432/memorylane_test
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=5

# --- Redis (empty = in-memory OTP/rate-limit backends) ---
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0

# --- Object storage (filesystem | s3) ---
STORAGE_DRIVER=filesystem
STORAGE_DIR=./.devdata/storage
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_BUCKET_ORIGINALS=memorylane-originals
S3_BUCKET_DERIVATIVES=memorylane-derivatives
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=auto
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Email (memory | file | smtp) ---
MAIL_DRIVER=file
MAIL_DIR=./.devdata/mail
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
MAIL_FROM=Memory Lane <hello@example.com>
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

# --- Auth ---
FRONTEND_BASE_URL=http://localhost:3000
SESSION_COOKIE_NAME=ml_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=720
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
MAGIC_LINK_TTL_MINUTES=10
ALLOWED_ORIGINS=["http://localhost:3000"]

# --- Jobs (memory | arq) ---
JOBS_DRIVER=memory

# --- AI Studio (openrouter | fake; fake = deterministic stubs, no cost) ---
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_TEXT_MODEL=openai/gpt-4o-mini
AI_VISION_MODEL=openai/gpt-4o-mini
AI_AUDIO_MODEL=openai/whisper-large-v3
AI_AUDIO_SUPPORTED=false
AI_TIMEOUT_SECONDS=120
AI_MAX_OUTPUT_TOKENS=2000
AI_MAX_ATTEMPTS=3
AI_RETRY_BASE_SECONDS=2.0
FREE_MONTHLY_AI_TOKENS=100000
PREMIUM_MONTHLY_AI_TOKENS=5000000

# --- Ports ---
API_PORT=8000
WEB_PORT=3000

# --- Neon Auth JWT (optional bearer path; native OTP stays default) ---
NEON_AUTH_ENABLED=false
NEON_AUTH_JWKS_URL=
NEON_AUTH_JWKS_JSON=
NEON_AUTH_ISSUER=
NEON_AUTH_AUDIENCE=
NEON_AUTH_JWKS_TTL_SECONDS=3600

# --- Frontend ---
# /api = same-origin Next.js proxy to the backend (see frontend/next.config.ts).
NEXT_PUBLIC_API_BASE_URL=/api
PLAYWRIGHT_BASE_URL=http://localhost:3000
